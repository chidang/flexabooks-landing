---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 font-bold tracking-tight text-ink ${cls}`}>
  <!-- Cùng hình chữ F của favicon. Nền sáng đảo màu (ô nâu, chữ kem) để ô không chìm vào thanh menu. -->
  <svg viewBox="0 0 64 64" class="h-8 w-8 shrink-0" aria-hidden="true">
    <rect width="64" height="64" rx="14" class="fill-[#382518] dark:fill-[#F9F7EF]" />
    <g class="fill-[#F9F7EF] dark:fill-[#382518]">
      <rect x="16" y="12" width="32.5" height="8.5" rx="2.6" />
      <rect x="16" y="12" width="8.5" height="40" rx="2.6" />
      <rect x="16" y="28.5" width="18" height="8.5" rx="2.6" />
    </g>
  </svg>
  <span class="text-lg">Flexa<span class="text-brand-500 dark:text-brand-300">Books</span></span>
</span>
