---
// Nút Sáng / Theo máy / Tối ở thanh trên cùng và chân trang; nhiều bản cùng lúc vẫn khớp nhau vì script
// đọc mọi nút [data-theme-value]. Script nạp trước trong <head> (THEME_PRELOAD ở BaseLayout) áp class
// `dark` trước lần vẽ đầu để không nháy trắng.
const options = [
  { value: 'light', label: 'Sáng', icon: 'M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { value: 'auto', label: 'Theo máy', icon: 'M4 5h16v11H4zM8 20h8m-4-4v4' },
  { value: 'dark', label: 'Tối', icon: 'M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z' },
];
---
<div
  class="no-print inline-flex w-max items-center gap-0.5 rounded-full border border-line bg-surface p-0.5"
  role="radiogroup"
  aria-label="Giao diện sáng tối"
  data-theme-control
>
  {options.map((o) => (
    <button
      type="button"
      role="radio"
      data-theme-value={o.value}
      title={o.label}
      aria-label={o.label}
      class="grid h-7 w-7 place-items-center rounded-full text-muted transition hover:text-ink aria-checked:bg-brand-500 aria-checked:text-white"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.icon} /></svg>
    </button>
  ))}
</div>

<script>
  const KEY = 'flexabooks-theme';
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const read = () => {
    try { return localStorage.getItem(KEY) || 'auto'; } catch { return 'auto'; }
  };
  const apply = (mode: string) => {
    const dark = mode === 'dark' || (mode === 'auto' && media.matches);
    document.documentElement.classList.toggle('dark', dark);
    document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.themeValue === mode));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) => {
    b.addEventListener('click', () => {
      const mode = b.dataset.themeValue || 'auto';
      try { localStorage.setItem(KEY, mode); } catch {}
      apply(mode);
    });
  });
  media.addEventListener('change', () => { if (read() === 'auto') apply('auto'); });
  apply(read());
</script>
