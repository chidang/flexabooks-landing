---
// Ảnh chụp màn hình thật đặt trong khung trình duyệt. Ảnh đi qua astro:assets để ra WebP đúng cỡ.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; eager?: boolean; class?: string }
const { src, alt, eager = false, class: cls = '' } = Astro.props;
---
<figure class={`overflow-hidden rounded-xl border border-line bg-surface shadow-[0_20px_50px_-20px_rgb(71_49_31/0.35)] ${cls}`}>
  <div class="flex items-center gap-1.5 border-b border-line bg-canvas px-3 py-2" aria-hidden="true">
    <span class="h-2.5 w-2.5 rounded-full bg-[#e7ded6] dark:bg-[#3a2f27]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#e7ded6] dark:bg-[#3a2f27]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#e7ded6] dark:bg-[#3a2f27]"></span>
    <span class="ml-3 truncate rounded bg-surface px-2 py-0.5 text-[11px] text-muted">kt.flexa.vn</span>
  </div>
  <Image src={src} alt={alt} widths={[480, 800, 1200, 1440]} sizes="(min-width: 1024px) 640px, 100vw"
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} class="block h-auto w-full" />
</figure>
