---
import { FAQ } from '../data/faq';
---
<div data-reveal class="mx-auto max-w-3xl divide-y divide-line rounded-2xl border border-line bg-surface">
  {FAQ.map((f) => (
    <details class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
        {f.q}
        <svg viewBox="0 0 24 24" class="h-5 w-5 flex-none text-muted transition group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </summary>
      <p class="mt-3 leading-relaxed text-ink-soft">{f.a}</p>
    </details>
  ))}
</div>
