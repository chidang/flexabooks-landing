---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PricingCards from '../components/PricingCards.astro';
import Offers from '../components/Offers.astro';
import Faq from '../components/Faq.astro';
import { ALL_PLANS_INCLUDE, PLANS, SERVICE_FIRM, SERVICE_FIRM_TIERS, TRIAL_DAYS, formatTokens, formatUsers, formatVnd, tierLabel } from '../data/pricing';
import { faqJsonLd, softwareJsonLd } from '../lib/jsonld';

const site = Astro.site!;
const yes = '✓';
const no = '–';
// Bảng so ngắn: các gói khác nhau ở loại hình, số người dùng, Trợ lý AI và mức hỗ trợ.
const rows: { label: string; values: string[] }[] = [
  { label: 'Giá mỗi năm', values: PLANS.map((p) => formatVnd(p.pricePerYear)) },
  { label: 'Người dùng', values: PLANS.map((p) => formatUsers(p.users)) },
  { label: 'Trợ lý AI mỗi tháng', values: PLANS.map((p) => formatTokens(p.aiTokens)) },
  { label: 'Hộ kinh doanh (TT152/2025)', values: [yes, yes, yes] },
  { label: 'DN siêu nhỏ (TT58/2026)', values: [yes, yes, yes] },
  { label: 'DN theo TT133, TT99', values: [no, yes, yes] },
  { label: 'Quỹ, ngân hàng, hóa đơn, kho', values: [yes, yes, yes] },
  { label: 'Mua bán, công nợ, đơn hàng, hợp đồng', values: [yes, yes, yes] },
  { label: 'CCDC, TSCĐ, tiền lương, thuế TNCN', values: [yes, yes, yes] },
  { label: 'Sổ S1 đến S4d, B01, B02-DNSN', values: [yes, yes, yes] },
  { label: 'Tờ khai 01/GTGT theo tháng, quý', values: [yes, yes, yes] },
  { label: 'BCTC theo TT133, TT99; tờ khai 03/TNDN', values: [no, yes, yes] },
  { label: 'Ngoại tệ, đánh giá lại tỷ giá', values: [no, yes, yes] },
  { label: 'Giá thành sản xuất, công trình', values: [no, no, yes] },
  { label: 'Rà soát số liệu, nhập sổ từ phần mềm khác', values: [no, no, yes] },
  { label: 'Chuyển dữ liệu từ phần mềm cũ', values: [no, 'Miễn phí', 'Làm hộ bạn'] },
  { label: 'Hướng dẫn 1:1 trong 30 ngày đầu', values: [yes, yes, yes] },
  { label: 'Hỗ trợ', values: ['Zalo, điện thoại', 'Zalo, điện thoại', 'Ưu tiên, cả ngoài giờ'] },
];
---
<BaseLayout
  title="Bảng giá FlexaBooks · Từ 1.000.000đ mỗi năm"
  description={`Ba gói năm cho một công ty: ${PLANS.map((p) => formatVnd(p.pricePerYear)).join(", ")}. Không phí khởi tạo, không giới hạn chứng từ, dùng thử ${TRIAL_DAYS} ngày đủ tính năng.`}
  jsonLd={[softwareJsonLd(site), faqJsonLd()]}
>
  <Section eyebrow="Bảng giá" title="Giá năm, cho một công ty" lead={`Dùng thử ${TRIAL_DAYS} ngày đủ tính năng rồi mới chọn gói. Giá chưa gồm thuế GTGT. Không phí khởi tạo, không giới hạn số chứng từ.`}>
    <PricingCards placement="pricing-page" />
  </Section>

  <Section title="So sánh các gói" class="bg-surface">
    <div class="-mx-4 overflow-x-auto px-4">
      <table class="w-full min-w-[40rem] border-collapse text-sm">
        <thead>
          <tr class="border-b border-line text-left">
            <th class="py-3 pr-4 font-semibold text-muted" scope="col">Hạng mục</th>
            {PLANS.map((p) => <th class={`px-3 py-3 text-center font-bold ${p.featured ? 'text-brand-600 dark:text-brand-300' : 'text-ink'}`} scope="col">{p.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-line">
              <th class="py-3 pr-4 text-left font-medium text-ink-soft" scope="row">{r.label}</th>
              {r.values.map((v) => <td class={`px-3 py-3 text-center ${v === yes ? 'font-bold text-accent' : v === no ? 'text-muted' : 'text-ink'}`}>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-muted">Bảng cuộn ngang trên điện thoại.</p>
    <p class="mt-6 text-center text-sm text-ink-soft">Cần mẫu chứng từ, báo cáo, cách tính riêng hay kết nối với phần mềm khác? Xem <a class="font-semibold text-brand-600 hover:underline" href="/dich-vu">dịch vụ theo yêu cầu</a>, báo giá theo từng việc.</p>

    <div class="mt-12 rounded-2xl border border-line bg-canvas p-6">
      <h3 class="text-center font-bold text-ink">Gói nào cũng có</h3>
      <ul class="mt-4 grid gap-x-6 gap-y-2 text-sm text-ink-soft sm:grid-cols-2 lg:grid-cols-4">
        {ALL_PLANS_INCLUDE.map((x) => <li class="flex gap-2"><span class="text-accent">✓</span>{x}</li>)}
      </ul>
    </div>
  </Section>

  <Section id="ke-toan-dich-vu" eyebrow="Kế toán dịch vụ" title="Giá cho đơn vị giữ sổ nhiều công ty" lead={`Một tài khoản đăng nhập dùng cho mọi công ty bạn giữ sổ. Từ ${SERVICE_FIRM.fromCompany} công ty trở lên, giá mỗi công ty tính theo tổng số công ty bạn mua.`}>
    <div class="mx-auto grid max-w-3xl gap-4 sm:grid-cols-3">
      {SERVICE_FIRM_TIERS.map((t, i) => (
        <div class="lift rounded-2xl border border-line bg-surface p-6 text-center" data-reveal style={`--d:${i * 80}ms`}>
          <p class="text-sm font-semibold text-muted">{tierLabel(t)}</p>
          <p class="mt-2 text-2xl font-extrabold text-ink">{formatVnd(t.pricePerYear)}</p>
          <p class="mt-1 text-sm text-muted">mỗi công ty, mỗi năm</p>
        </div>
      ))}
    </div>
    <ul class="mx-auto mt-6 max-w-3xl space-y-2 text-sm text-ink-soft">
      <li class="flex gap-2"><span class="text-accent">✓</span>Mỗi công ty dùng đủ tính năng gói Doanh nghiệp, kể cả hộ kinh doanh và doanh nghiệp siêu nhỏ.</li>
      <li class="flex gap-2"><span class="text-accent">✓</span>Công ty có sản xuất, công trình cần gói Chuyên nghiệp thì giảm {SERVICE_FIRM.proPercent}% giá gói đó.</li>
      <li class="flex gap-2"><span class="text-accent">✓</span>Thêm công ty giữa năm thì tính theo số tháng còn lại; đủ số công ty của bậc sau thì cả đơn sang giá bậc sau từ kỳ gia hạn.</li>
    </ul>
  </Section>

  <Section eyebrow="Ưu đãi" title="Ưu đãi cho khách hàng mới" class="bg-surface">
    <Offers />
  </Section>

  <Section id="cau-hoi" eyebrow="Hỏi đáp" title="Câu hỏi về giá và thanh toán" class="bg-surface">
    <Faq />
  </Section>
</BaseLayout>
