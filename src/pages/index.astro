  <!-- Chuyển dữ liệu -->
  <Section eyebrow="Chuyển sang FlexaBooks" title="Đang dùng phần mềm khác?" lead="Mang số dư và sổ nhật ký chung sang, không phải nhập lại từ đầu năm." class="bg-surface">
