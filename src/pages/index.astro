      </div>

      <figure role="img" aria-label="Minh họa trang Công ty của tôi: ô tìm theo tên hoặc mã số thuế và danh sách công ty, mỗi dòng có nút chuyển sang công ty đó"
        class="overflow-hidden rounded-xl border border-line bg-surface shadow-[0_20px_50px_-20px_rgb(71_49_31/0.35)]">
        <div class="flex items-center gap-1.5 border-b border-line bg-canvas px-3 py-2" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-[#e7ded6] dark:bg-[#3a2f27]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#e7ded6] dark:bg-[#3a2f27]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#e7ded6] dark:bg-[#3a2f27]"></span>
