            Tìm theo tên hoặc mã số thuế
          </div>
          <ul class="mt-3 divide-y divide-line rounded-lg border border-line">
            {demoCompanies.map((c) => (
              <li class={`flex items-center gap-3 px-3 py-2.5 ${c.active ? 'bg-brand-50 dark:bg-brand-700/20' : ''}`}>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold text-ink">{c.name}</p>
                  <p class="truncate text-xs text-muted">MST {c.tax} · {c.role}</p>
                </div>
                {c.active
                  ? <span class="flex-none rounded-full bg-brand-500 px-2 py-0.5 text-[11px] font-semibold text-white">Đang làm việc</span>
