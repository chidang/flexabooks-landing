          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{s.lead}</p>
          <ul class="mt-4 space-y-1.5 text-sm text-ink-soft">
            {s.items.map((it) => <li class="flex gap-2"><span class="text-accent">✓</span>{it.t}</li>)}
