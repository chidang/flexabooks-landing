        <BrowserFrame src={aiLapNhap} alt="Màn Chứng từ AI lập nháp: lần chạy sau khi nhập sao kê, bốn chứng từ nháp lập theo quy tắc chờ kế toán ghi sổ, nút hoàn tác lần chạy" />
      </div>
    </div>
  </Section>

